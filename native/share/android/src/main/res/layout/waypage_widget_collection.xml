<?xml version="1.0" encoding="utf-8"?>
<!-- One collection (0.35.0; its own layout in 1.2.1): its name and the
     clip to read next, with a Start, Continue or Read again button held
     to the bottom (1.10.2: Daniel wanted the button at the foot and no
     list of clips after it; a FrameLayout keeps it there even when a
     short widget has to cover the clip's second line). w_fav1-3 stay,
     hidden, because Widgets.java hides every FAVS row by id.
     The texts here are what the widget picker's preview shows; the app's
     data replaces every one of them (Widgets.collection). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/waypage_widget_bg"
    android:padding="@dimen/waypage_w_pad">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:id="@+id/w_head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/waypage_w_collection"
            android:textColor="@color/waypage_w_muted"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/waypage_w_muted"
            android:textSize="14sp"
            android:visibility="gone" />
        <LinearLayout
            android:id="@+id/w_fav0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="44dp"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:visibility="visible">
            <TextView
                android:id="@+id/w_fav0_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:maxLines="2"
                android:text="@string/waypage_w_collection_eg1"
                android:textColor="@color/waypage_w_ink"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_fav0_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/waypage_w_collection_eg_meta"
                android:textColor="@color/waypage_w_muted"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_fav1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="44dp"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:id="@+id/w_fav1_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:maxLines="1"
                android:text="@string/waypage_w_collection_eg2"
                android:textColor="@color/waypage_w_ink"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_fav1_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/waypage_w_collection_eg_meta"
                android:textColor="@color/waypage_w_muted"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_fav2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="44dp"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:id="@+id/w_fav2_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:maxLines="1"
                android:textColor="@color/waypage_w_ink"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_fav2_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/waypage_w_muted"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_fav3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="44dp"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:id="@+id/w_fav3_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:maxLines="1"
                android:textColor="@color/waypage_w_ink"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_fav3_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/waypage_w_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
    <!-- Continue, and beside it the same with read aloud (1.25.0). Its
         label stays on one line, its type shrinking to fit (1.26.1). -->
    <LinearLayout
        android:id="@+id/w_goRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/w_go"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="13sp"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:background="@drawable/waypage_widget_pill"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="@string/waypage_w_start"
            android:textColor="@color/waypage_w_bg"
            android:textSize="13sp"
            android:textStyle="bold" />
        <ImageView
            android:id="@+id/w_aloud"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="8dp"
            android:background="@drawable/waypage_widget_pill"
            android:contentDescription="@string/waypage_w_aloud"
            android:padding="10dp"
            android:src="@drawable/waypage_w_aloud" />
    </LinearLayout>
</FrameLayout>
