<?xml version="1.0" encoding="utf-8"?>
<!-- One reading figure (1.39.0): Today, or Days in a row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/waypage_widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">
    <TextView
        android:id="@+id/w_head"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/waypage_w_muted"
        android:textSize="12sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/w_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="serif"
        android:maxLines="1"
        android:textColor="@color/waypage_w_ink"
        android:textSize="22sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/w_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/waypage_w_muted"
        android:textSize="12sp" />
</LinearLayout>
