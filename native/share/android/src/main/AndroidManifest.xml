<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Read aloud (0.27.0): a media-playback service that goes on with the
         screen off. TextToSpeech can only find the phone's engine when the
         app says it looks for one (Android 11's package visibility). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Downloads (0.27.9): a data-sync service that keeps the app running
         while pages are saved, with a progress notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Feeds (0.28.4): read every few hours with the app closed, a job
         that survives a restart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
    <application>
        <service
            android:name="io.github.danielnoam.waypage.share.SpeechService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <service
            android:name="io.github.danielnoam.waypage.share.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name="io.github.danielnoam.waypage.share.FeedCheckJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- Google Drive backups with the app closed (1.47.0). -->
        <service
            android:name="io.github.danielnoam.waypage.share.DriveBackupJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- Home screen widgets (0.29.0). -->
        <receiver
            android:name="io.github.danielnoam.waypage.share.ReadingWidget"
            android:exported="false"
            android:label="@string/waypage_w_reading">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/waypage_widget_reading_info" />
        </receiver>
        <receiver
            android:name="io.github.danielnoam.waypage.share.FeedsWidget"
            android:exported="false"
            android:label="@string/waypage_w_feeds">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/waypage_widget_feeds_info" />
        </receiver>
        <receiver
            android:name="io.github.danielnoam.waypage.share.FavouritesWidget"
            android:exported="false"
            android:label="@string/waypage_w_favourites">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/waypage_widget_favourites_info" />
        </receiver>
        <!-- A highlight a day (1.9.0). -->
        <receiver
            android:name="io.github.danielnoam.waypage.share.HighlightWidget"
            android:exported="false"
            android:label="@string/waypage_w_highlight">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/waypage_widget_highlight_info" />
        </receiver>
        <!-- Reading stats (1.39.0): this week, today, days in a row. -->
        <receiver
            android:name="io.github.danielnoam.waypage.share.StatsWeekWidget"
            android:exported="false"
            android:label="@string/waypage_w_week">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/waypage_widget_week_info" />
        </receiver>
        <receiver
            android:name="io.github.danielnoam.waypage.share.StatsTodayWidget"
            android:exported="false"
            android:label="@string/waypage_w_today">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/waypage_widget_today_info" />
        </receiver>
        <receiver
            android:name="io.github.danielnoam.waypage.share.StatsRunWidget"
            android:exported="false"
            android:label="@string/waypage_w_run">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/waypage_widget_run_info" />
        </receiver>
        <!-- One collection (0.35.0), picked when the widget is placed. -->
        <receiver
            android:name="io.github.danielnoam.waypage.share.CollectionWidget"
            android:exported="false"
            android:label="@string/waypage_w_collection">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/waypage_widget_collection_info" />
        </receiver>
        <activity
            android:name="io.github.danielnoam.waypage.share.CollectionPickActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/WaypagePick">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>
</manifest>
